# Normaliza los saltos de linea: en el repositorio siempre LF.
# Sin esto, un equipo Windows con core.autocrlf=true genera diferencias
# ficticias en todos los archivos.
* text=auto eol=lf

# Binarios: no tocar.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mo   binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
